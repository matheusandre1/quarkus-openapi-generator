      "VehicleResponseObjectResponseBody": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "GoaPaginationResponseResponseBody": {
        "type": "object",
        "properties": {
          "endCursor": { "type": "string" },
